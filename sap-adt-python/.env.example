# SAP ADT Connection Configuration
# Copy this file to .env and fill in your values.
#
# RECOMMENDED: Use sap_save_password to store credentials securely in the
# OS credential manager (Windows Credential Manager / macOS Keychain).
# Then connect with: sap_connect(system_id="ED2")
#
# The password should NOT be stored in this file. Use one of:
#   1. sap_save_password (stores in OS credential manager - recommended)
#   2. SAP_PASSWORD environment variable
#   3. Pass directly to sap_connect (not recommended)

SAP_HOST=host_icm.empresa.com.br
SAP_PORT=8000
SAP_CLIENT=100
SAP_USER=username
SAP_LANGUAGE=EN
SAP_USE_HTTPS=false
SAP_VERIFY_SSL=false
